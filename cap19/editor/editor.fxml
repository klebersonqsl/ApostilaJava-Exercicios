<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioMenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.HTMLEditor?>

<BorderPane prefHeight="620.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="editor.EditorController">
   <top>
      <VBox>
         <MenuBar>
            <Menu text="Arquivo">
               <MenuItem accelerator="Shortcut+N" onAction="#novo" text="Novo" />
               <MenuItem accelerator="Shortcut+O" onAction="#abrir" text="Abrir..." />
               <MenuItem accelerator="Shortcut+S" onAction="#salvar" text="Salvar" />
               <MenuItem onAction="#salvarComo" text="Salvar como..." />
               <SeparatorMenuItem />
               <MenuItem onAction="#visualizarImpressao" text="Visualizar impressão" />
               <MenuItem accelerator="Shortcut+P" onAction="#imprimir"
                         text="Imprimir..." />
               <SeparatorMenuItem />
               <MenuItem onAction="#sair" text="Sair" />
            </Menu>
            <Menu text="Exibir">
               <RadioMenuItem fx:id="itemClaro" onAction="#temaClaro" selected="true"
                              text="Tema claro">
                  <toggleGroup>
                     <ToggleGroup fx:id="grupoTema" />
                  </toggleGroup>
               </RadioMenuItem>
               <RadioMenuItem fx:id="itemEscuro" onAction="#temaEscuro"
                              text="Tema escuro" toggleGroup="$grupoTema" />
            </Menu>
            <Menu text="Ajuda">
               <MenuItem onAction="#sobre" text="Sobre o WordPad Fx" />
            </Menu>
         </MenuBar>
         <ToolBar>
            <Button onAction="#novo" text="Novo" />
            <Button onAction="#abrir" text="Abrir" />
            <Button onAction="#salvar" text="Salvar" />
            <Separator orientation="VERTICAL" />
            <Button onAction="#visualizarImpressao" text="Visualizar impressão" />
            <Button onAction="#imprimir" text="Imprimir" />
            <Separator orientation="VERTICAL" />
            <ToggleButton fx:id="botaoTema" onAction="#alternarTema" text="Tema escuro" />
         </ToolBar>
      </VBox>
   </top>
   <center>
      <!-- editor de texto com formatação: fontes, negrito, cores, listas, alinhamento -->
      <HTMLEditor fx:id="editor" />
   </center>
   <bottom>
      <HBox spacing="16.0" styleClass="barra-status">
         <padding>
            <Insets bottom="4.0" left="10.0" right="10.0" top="4.0" />
         </padding>
         <Label fx:id="statusArquivo" text="Documento novo" />
         <Pane HBox.hgrow="ALWAYS" />
         <Label fx:id="statusPalavras" text="0 palavra(s)" />
      </HBox>
   </bottom>
</BorderPane>
